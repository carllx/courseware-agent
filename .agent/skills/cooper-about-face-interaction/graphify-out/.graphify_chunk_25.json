    {
      "id": "about_face_chunks_chunk_601_convey_a_sense_of_the_function_icons",
      "label": "Icons",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_601_Convey_a_sense_of_the_function.md",
      "rationale": "Icons representing abstract concepts should rely on idioms rather than forced concrete representations. For concrete functions, represent both action and object acted on."
    },
    {
      "id": "about_face_chunks_chunk_602_associate_visual_symbols_with__visual_symbols",
      "label": "Visual Symbols",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_602_Associate_visual_symbols_with_.md"
    },
    {
      "id": "about_face_chunks_chunk_602_associate_visual_symbols_with__visually_distinguish",
      "label": "Visually distinguish elements that behave differently",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_602_Associate_visual_symbols_with_.md"
    },
    {
      "id": "about_face_chunks_chunk_603_render_icons_and_visual_symbol_render_simply",
      "label": "Render icons and visual symbols simply",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_603_Render_icons_and_visual_symbol.md",
      "rationale": "Icons should remain simple and schematic, minimizing colors and shades, to avoid drawing undue attention and rendering poorly at small sizes."
    },
    {
      "id": "about_face_chunks_chunk_604_pre_visualize_results_when_pos_pre_visualize",
      "label": "Pre-visualize results",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_604_Pre_visualize_results_when_pos.md",
      "rationale": "Use visual elements in addition to text to convey to users what the results of an interface function will be."
    },
    {
      "id": "about_face_chunks_chunk_605_respond_to_commands_feedback",
      "label": "Respond to commands",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_605_Respond_to_commands.md",
      "rationale": "Provide visual cues indicating a command was received, depending on the delay length (instant, <1s, 1-10s, >10s)."
    },
    {
      "id": "about_face_chunks_chunk_606_draw_attention_to_important_ev_attention",
      "label": "Draw attention to important events",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_606_Draw_attention_to_important_ev.md",
      "rationale": "Use contrast (size, color, motion) to draw attention proactively, but avoid misapplying it as it can interrupt the user's current task."
    },
    {
      "id": "about_face_chunks_chunk_607_minimize_the_amount_of_visual__visual_noise",
      "label": "Visual Noise",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_607_Minimize_the_amount_of_visual_.md",
      "rationale": "Superfluous visual elements (ornate embellishment, 3D rendering without info, heavy rules, crowding) increase cognitive load and should be minimized."
    },
    {
      "id": "about_face_chunks_chunk_608_keep_it_simple_simplicity",
      "label": "Keep it simple",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_608_Keep_it_simple.md",
      "rationale": "Visual interfaces should be minimal. Unnecessary variation is the enemy of coherent design."
    },
    {
      "id": "about_face_chunks_chunk_609_design_principle_take_things_away",
      "label": "Take things away until the design breaks",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_609_DESIGN_PRINCIPLE.md"
    },
    {
