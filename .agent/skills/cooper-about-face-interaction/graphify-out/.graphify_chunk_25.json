    {
      "id": "about_face_chunks_chunk_610_visual_information_design_prin_grand_principles",
      "label": "Seven Grand Principles of Information Design",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_610_Visual_Information_Design_Prin.md"
    },
    {
      "id": "about_face_chunks_chunk_611_enforce_visual_comparisons_enforce_comparisons",
      "label": "Enforce visual comparisons",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_611_Enforce_visual_comparisons.md",
      "rationale": "Provide a means for users to compare related variables and trends or to compare before-and-after scenarios."
    },
    {
      "id": "about_face_chunks_chunk_612_show_causality_show_causality",
      "label": "Show causality",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_612_Show_causality.md",
      "rationale": "Clarify cause and effect within information graphics."
    },
    {
      "id": "about_face_chunks_chunk_613_show_multiple_variables_show_multiple_variables",
      "label": "Show multiple variables",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_613_Show_multiple_variables.md",
      "rationale": "Data displays should show multiple related variables simultaneously without sacrificing clarity."
    },
    {
      "id": "about_face_chunks_chunk_614_integrate_text__graphics__and__integrate_text_graphics",
      "label": "Integrate text, graphics, and data in one display",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_614_Integrate_text__graphics__and_.md",
      "rationale": "Avoid separate keys or legends as they require additional cognitive processing."
    },
    {
      "id": "about_face_chunks_chunk_615_ensure_the_content_s_quality___ensure_quality",
      "label": "Ensure the content's quality, relevance, and integrity",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_615_Ensure_the_content_s_quality__.md"
    },
    {
      "id": "about_face_chunks_chunk_616_show_things_adjacent_in_space__show_adjacent_in_space",
      "label": "Show things adjacent in space, not stacked in time",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_616_Show_things_adjacent_in_space_.md",
      "rationale": "Changes over time are easier to understand when shown side-by-side rather than superimposed."
    },
    {
      "id": "about_face_chunks_chunk_617_don_t_dequantify_quantifiable__dont_dequantify",
      "label": "Don't dequantify quantifiable data",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_617_Don_t_dequantify_quantifiable_.md",
      "rationale": "Do not abandon the display of the numbers themselves even when using graphs and charts."
    },
    {
      "id": "about_face_chunks_chunk_618_consistency_and_standards_consistency",
      "label": "Interface Consistency and Standards",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_618_Consistency_and_Standards.md",
      "rationale": "Standards improve users' ability to learn and predict behaviors, but rigid adherence without considering context can force inappropriate interaction models."
    },
    {
      "id": "about_face_chunks_chunk_622_when_to_violate_guidelines_obey_standards",
      "label": "Obey standards unless there is a truly superior alternative",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_623_DESIGN_PRINCIPLE.md"
    },
    {
      "id": "about_face_chunks_chunk_624_consistency_and_standards_acro_consistency_not_rigidity",
      "label": "Consistency doesn't imply rigidity",
      "file_type": "rationale",
      "source_file": "/private/tmp/about_face_chunks/chunk_624_Consistency_and_standards_acro.md"
    },
    {
      "id": "about_face_chunks_chunk_625_the_design_language_design_language",
      "label": "Design Language",
      "file_type": "concept",
      "source_file": "/private/tmp/about_face_chunks/chunk_625_The_design_language.md",
      "rationale": "A vocabulary of design elements (shape, color, typography) composed to create emotional tone and brand associations."
    }
