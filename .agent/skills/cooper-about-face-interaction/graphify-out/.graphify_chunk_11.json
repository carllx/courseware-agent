{"nodes": [{"id": "about_face_chunks_chunk_251_conducting_formative_usability_formative_usability_tests", "label": "Formative Usability Tests", "file_type": "concept", "source_file": "about_face_chunks/chunk_251_Conducting_formative_usability.md", "rationale": "Test late enough to be concrete, early enough to allow adjustments. Use personas as guide, test explicitly defined tasks while thinking aloud, use low-tech prototype, minimize bias."}, {"id": "about_face_chunks_chunk_251_conducting_formative_usability_paper_prototyping", "label": "Paper Prototyping (Carolyn Snyder)", "file_type": "document", "source_file": "about_face_chunks/chunk_251_Conducting_formative_usability.md"}, {"id": "about_face_chunks_chunk_252_designer_involvement_in_usabil_designer_involvement", "label": "Designer Involvement in Usability", "file_type": "concept", "source_file": "about_face_chunks/chunk_252_Designer_involvement_in_usabil.md", "rationale": "Designers should be involved in study planning, observation, and analysis to directly witness user interactions."}, {"id": "about_face_chunks_chunk_255_small__focused_teams_core_teams", "label": "Core Teams", "file_type": "concept", "source_file": "about_face_chunks/chunk_255_Small__Focused_Teams.md", "rationale": "Small and focused teams arranged around specific expertise, responsible for getting work done efficiently without bloat. Best size is 2 to 4 members."}, {"id": "about_face_chunks_chunk_255_small__focused_teams_extended_teams", "label": "Extended Teams", "file_type": "concept", "source_file": "about_face_chunks/chunk_255_Small__Focused_Teams.md", "rationale": "Large and sometimes geographically distributed, including stakeholders and separate core teams like marketing, design, and engineering."}, {"id": "about_face_chunks_chunk_256_thinking_better__together_thought_partnership", "label": "Thought Partnership", "file_type": "rationale", "source_file": "about_face_chunks/chunk_256_Thinking_Better__Together.md", "rationale": "A collaborative effort blending generative and synthetic thinking. Partners share goals but approach problems from different angles."}, {"id": "about_face_chunks_chunk_256_thinking_better__together_thinking_fast_and_slow", "label": "Thinking, Fast and Slow (Daniel Kahneman, Amos Tversky)", "file_type": "document", "source_file": "about_face_chunks/chunk_256_Thinking_Better__Together.md"}, {"id": "about_face_chunks_chunk_257_generators_and_synthesizers_generator", "label": "Generator", "file_type": "concept", "source_file": "about_face_chunks/chunk_257_Generators_and_synthesizers.md", "rationale": "Generates ideas freely, thinks laterally, explores openly. Tends to be concrete thinkers who grab the marker to visualize ideas."}, {"id": "about_face_chunks_chunk_257_generators_and_synthesizers_synthesizer", "label": "Synthesizer", "file_type": "concept", "source_file": "about_face_chunks/chunk_257_Generators_and_synthesizers.md", "rationale": "Evaluates, seeks clarity, draws connections, and guides the discussion to ensure user needs are addressed. Focuses on storytelling and asking questions."}, {"id": "about_face_chunks_chunk_262_getting_unstuck__the_15_minute_15_minute_rule", "label": "15-Minute Rule", "file_type": "rationale", "source_file": "about_face_chunks/chunk_262_Getting_unstuck__the_15_minute.md", "rationale": "If discussion doesn't advance for 15 minutes, bring in an outside designer to probe for rationale and help lift the team out of details."}, {"id": "about_face_chunks_chunk_263_rightsizing_core_teams_scaling_up_excellence", "label": "Scaling Up Excellence (Robert Sutton, Huggy Rao)", "file_type": "document", "source_file": "about_face_chunks/chunk_263_Rightsizing_core_teams.md"}, {"id": "about_face_chunks_chunk_265_interaction_design_interaction_design", "label": "Interaction Design", "file_type": "concept", "source_file": "about_face_chunks/chunk_265_Interaction_design.md"}, {"id": "about_face_chunks_chunk_266_visual_interface_design_visual_interface_design", "label": "Visual Interface Design", "file_type": "concept", "source_file": "about_face_chunks/chunk_266_Visual_interface_design.md"}, {"id": "about_face_chunks_chunk_267_graphic_design_graphic_design", "label": "Graphic Design", "file_type": "concept", "source_file": "about_face_chunks/chunk_267_Graphic_design.md"}, {"id": "about_face_chunks_chunk_268_visual_information_design_visual_information_design", "label": "Visual Information Design", "file_type": "concept", "source_file": "about_face_chunks/chunk_268_Visual_information_design.md"}, {"id": "about_face_chunks_chunk_268_visual_information_design_visual_display_of_quantitative_information", "label": "The Visual Display of Quantitative Information (Edward Tufte)", "file_type": "document", "source_file": "about_face_chunks/chunk_268_Visual_information_design.md"}, {"id": "about_face_chunks_chunk_269_industrial_design_industrial_design", "label": "Industrial Design", "file_type": "concept", "source_file": "about_face_chunks/chunk_269_Industrial_design.md"}, {"id": "about_face_chunks_chunk_269_industrial_design_designing_for_the_digital_age", "label": "Designing for the Digital Age (Kim Goodwin)", "file_type": "document", "source_file": "about_face_chunks/chunk_269_Industrial_design.md"}, {"id": "about_face_chunks_chunk_271_areas_of_responsibility_and_au_design", "label": "Design Responsibility", "file_type": "concept", "source_file": "about_face_chunks/chunk_271_Areas_of_responsibility_and_au.md", "rationale": "Responsible for users' goals for the product, deciding how it will look, feel, and behave."}, {"id": "about_face_chunks_chunk_271_areas_of_responsibility_and_au_usability", "label": "Usability Responsibility", "file_type": "concept", "source_file": "about_face_chunks/chunk_271_Areas_of_responsibility_and_au.md", "rationale": "Responsible for validating that users respond to the design as intended. Focuses on identifying problems."}, {"id": "about_face_chunks_chunk_271_areas_of_responsibility_and_au_engineering", "label": "Engineering Responsibility", "file_type": "concept", "source_file": "about_face_chunks/chunk_271_Areas_of_responsibility_and_au.md", "rationale": "Responsible for construction, materials, processes, estimating time and cost."}, {"id": "about_face_chunks_chunk_271_areas_of_responsibility_and_au_marketing", "label": "Marketing Responsibility", "file_type": "concept", "source_file": "about_face_chunks/chunk_271_Areas_of_responsibility_and_au.md", "rationale": "Responsible for defining the market opportunity, customer needs, and inspiring adoption."}, {"id": "about_face_chunks_chunk_271_areas_of_responsibility_and_au_business_leads", "label": "Business Leads Responsibility", "file_type": "concept", "source_file": "about_face_chunks/chunk_271_Areas_of_responsibility_and_au.md", "rationale": "Responsible for defining the business opportunity, prioritizing features, and ensuring profitability."}, {"id": "about_face_chunks_chunk_272_collaborating_with_agile_devel_agile_development", "label": "Agile Development", "file_type": "concept", "source_file": "about_face_chunks/chunk_272_Collaborating_with_agile_devel.md", "rationale": "Values speed and iterations. Requires primary elements of an experience to be planned and discussed before being built."}, {"id": "about_face_chunks_chunk_274_defining_the_user_experience_o_lean_ux", "label": "Lean UX (Jeff Gothelf and Josh Seiden)", "file_type": "document", "source_file": "about_face_chunks/chunk_274_Defining_the_user_experience_o.md"}], "edges": [{"source": "about_face_chunks_chunk_251_conducting_formative_usability_formative_usability_tests", "target": "about_face_chunks_chunk_251_conducting_formative_usability_paper_prototyping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "about_face_chunks/chunk_251_Conducting_formative_usability.md"}, {"source": "about_face_chunks_chunk_251_conducting_formative_usability_formative_usability_tests", "target": "about_face_chunks_chun